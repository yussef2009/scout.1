{
  "version": 4,
  "configurations": [
    {
      "name": "ESP32 Arduino",
      "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++.exe",
      "compilerArgs": [
        "-mlongcalls"
      ],
      "includePath": [
        "${workspaceFolder}/embedded/esp/espcode/src",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/**",
        "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32/**"
      ],
      "defines": [
        "ESP32",
        "ARDUINO=10819",
        "ARDUINO_ARCH_ESP32",
        "F_CPU=240000000L"
      ],
      "cStandard": "c17",
      "cppStandard": "gnu++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ]
}
