# ========================================================
# ScoutAI 2.0 Environment Configuration
# ========================================================

# Application & Runtime
ENVIRONMENT=development
PORT=8000
SECRET_KEY=scoutai_super_secret_jwt_key_change_in_production_2026
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Set SQLITE_FALLBACK=true to run out-of-the-box without PostgreSQL
SQLITE_FALLBACK=true
DATABASE_URL=postgresql://scout:scoutpass@localhost:5432/scoutai_db

# Redis Cache / Queue
REDIS_URL=redis://localhost:6379/0

# Storage Engine (local | s3 | r2)
# 'local' saves files to LOCAL_UPLOAD_DIR with zero cloud configuration
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / Cloudflare R2 Credentials (Optional for cloud deployments)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=scoutai-videos
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_REGION=auto
S3_PUBLIC_DOMAIN=https://media.scoutai.dev

# Google Gemini API Configuration (Server-Side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.8-flash

# Computer Vision Pipeline Mode (lightweight | full)
# 'lightweight' uses OpenCV frame sampling & motion detection on CPU
# 'full' runs YOLOv11n + ByteTrack + Homography on CUDA / GPU
CV_MODE=lightweight
YOLO_MODEL=yolo11n.pt

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
