# ==============================================================================
# SCOT AI (Scout AI) - Production Environment Configuration
# Stack: MongoDB Atlas, Appwrite Storage, Sentry, Datadog & Azure Container Apps
# ==============================================================================

# ── General Runtime & Domain Settings ─────────────────────────────────────────
ENV="production"
PORT=8000
HOST="0.0.0.0"
CUSTOM_DOMAIN="https://your-domain.tech"
FRONTEND_URL="https://your-domain.tech"
API_SUBDOMAIN="https://api.your-domain.tech"

# ── Authentication & Third-Party AI Models ────────────────────────────────────
# Clerk Secret Key for user token verification and identity mapping
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key_here"

# Roboflow Universe API Key for domain-specific fine-tuned sports models
ROBOFLOW_API_KEY="your_roboflow_api_key_here"

# ── MongoDB Atlas (Database & Telemetry Store) ─────────────────────────────────
# Connection string from MongoDB Atlas Database Deployment -> Connect
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@scot-cluster.mongodb.net/?retryWrites=true&w=majority&appName=scot-ai"
MONGODB_DB_NAME="scot_ai_db"

# ── Appwrite Cloud Storage (Match Video Storage Bucket) ───────────────────────
# Cloud or Self-hosted Appwrite REST API Endpoint
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_appwrite_project_id_here"
# Server-side API key with 'files.read' and 'files.write' scope
APPWRITE_API_KEY="your_appwrite_server_secret_api_key_here"
# Storage bucket created for match videos (.mp4 / .webm)
APPWRITE_BUCKET_ID="scot-match-videos"

# ── Sentry Error Tracking & APM Profiling ──────────────────────────────────────
# Project DSN from Sentry Dashboard -> Settings -> Client Keys
SENTRY_DSN="https://your_sentry_key@o0.ingest.sentry.io/0000000"

# ── Datadog Telemetry, APM & Custom Metrics ───────────────────────────────────
# Organization API key from Datadog -> Organization Settings -> API Keys
DD_API_KEY="your_datadog_api_key_here"
DD_SITE="datadoghq.com"
DD_SERVICE="scot-ai-api"
DD_ENV="production"
DD_VERSION="2.0.0"

